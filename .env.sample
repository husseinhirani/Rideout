# Copy to root .env.local. Never commit credentials or real participant numbers.
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=rideout-local-stage1
BACKEND_URL=http://127.0.0.1:8787

# Live phone run; use SIMULATE=1 only when deliberately avoiding real calls.
SIMULATE=0
AUTO_COORDINATE=1
COORDINATOR_SCRIPTED=0
INBOUND_REQUESTS=1

CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
CARTESIA_FROM_NUMBER_ID=
NGROK_URL=
ANTHROPIC_API_KEY=
# Optional override; empty also uses Claude Sonnet 5.5.
CLAUDE_MODEL=claude-sonnet-5-5
# Generate two DIFFERENT values with: openssl rand -hex 24
CALLBACK_SECRET=
OPERATOR_SECRET=

# Optional browser-visible Google Maps key for photorealistic 3D tiles.
# Restrict this key to the needed APIs and local app origins in Google Cloud.
VITE_GOOGLE_MAPS_KEY=
