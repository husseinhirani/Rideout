{
  "name": "record_find_helper",
  "description": "Record whether this person will help. Call it once they accept or decline.",
  "pre_tool_speech": "auto",
  "execution_mode": "immediate",
  "response_timeout_secs": 45,
  "api_schema": {
    "url": "/find-helper",
    "method": "POST",
    "request_body_schema": {
      "type": "object",
      "properties": {
        "support_case_id": {
          "type": "string",
          "dynamic_variable": "support_case_id"
        },
        "profile_id": {
          "type": "string",
          "dynamic_variable": "profile_id"
        },
        "outcome": {
          "type": "string",
          "enum": ["accepted", "declined"],
          "description": "accepted if they will help. declined if they will not."
        }
      },
      "required": ["outcome"]
    }
  }
}
