{
  "name": "record_check_in",
  "description": "Record this person's check-in. Call it once they say they are safe or that they need help.",
  "pre_tool_speech": "auto",
  "execution_mode": "immediate",
  "response_timeout_secs": 45,
  "api_schema": {
    "url": "/check-ins",
    "method": "POST",
    "request_body_schema": {
      "type": "object",
      "properties": {
        "incident_id": {
          "type": "string",
          "dynamic_variable": "incident_id"
        },
        "profile_id": {
          "type": "string",
          "dynamic_variable": "profile_id"
        },
        "result": {
          "type": "string",
          "enum": ["safe", "victim"],
          "description": "safe if the person does not need help. victim if they explicitly need help."
        }
      },
      "required": ["result"]
    }
  }
}
